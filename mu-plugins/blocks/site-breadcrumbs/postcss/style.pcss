.wp-block-wporg-site-breadcrumbs {
	position: relative;
	max-width: 100%;
	mask-image: linear-gradient(to right, #000 calc(100% - 60px), transparent);

	[dir="rtl"] & {
		mask-image: linear-gradient(to left, #000 calc(100% - 60px), transparent);
	}

	& .wporg-site-breadcrumbs__wrapper {
		display: flex;
		align-items: baseline;
		overflow-x: auto;
		text-overflow: clip;
		white-space: nowrap;

		/* Add extra space so the page title can be fully visible when scrolled. */
		&::after {
			content: "";
			flex-shrink: 0;
			width: 60px;
		}
	}

	& a {
		color: var(--wp--preset--color--charcoal-4);
		text-decoration-line: none;

		&:hover {
			text-decoration-line: underline;
		}
	}

	/* Inside the flex wrapper these are block-level items, so screen readers like NVDA read each crumb on its own. */
	& span {
		display: inline-block;
		flex-shrink: 0;

		&:not(:last-child) {

			/* This ensures that the square separator is reliably centered. */
			margin-top: 0;

			&::after {
				content: "/";
				content: "/" / ""; /* Hide the separator from screen readers where supported. */
				display: inline-block;
				font-weight: 400;
				margin: 0 var(--wp--preset--spacing--10);
				color: var(--wp--preset--color--light-grey-1);
			}
		}
	}
}
