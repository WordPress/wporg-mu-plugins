.wp-block-group.global-footer {
	clear: both;
	padding: 44px var(--wp--preset--spacing--edge-space, 20px);

	@media (--tablet) {
		padding-top: 69px;
		padding-bottom: 58px;
		padding-left: var(--wp--preset--spacing--edge-space, 80px);
		padding-right: var(--wp--preset--spacing--edge-space, 80px);
	}

	& > .global-footer__navigation-container {
		align-items: start;
		row-gap: 35px;

		/* Create columns automatically, make them equal widths, wrap when needed. */
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		container-type: normal;

		@media (--tablet) {
			font-size: var(--wp--preset--font-size--small);
		}

		& ul {
			list-style: none;
			padding: 0;
			margin-top: 0;

			& li + li {
				margin-top: 5px;
			}
		}
	}

	& .wp-block-navigation__container {
		flex-direction: column;
		align-items: self-start;
	}
}

/* "Code is Poetry" sits in its own full-width strip at the very bottom of the footer, under a subtle divider. */
.wp-block-group.global-footer .global-footer__code-is-poetry-container {
	margin: 44px calc(-1 * var(--wp--preset--spacing--edge-space, 20px)) -44px;
	padding: 24px var(--wp--preset--spacing--edge-space, 20px);
	background-color: var(--wp-global-header--background-color--hover); /* A darker shade of the same hue. */
	color: var(--wp-global-header--text-color--light); /* Same as the trademark notice. */
	text-align: center;

	@media (--tablet) {
		margin-top: 58px;
		margin-right: calc(-1 * var(--wp--preset--spacing--edge-space, 80px));
		margin-bottom: -58px;
		margin-left: calc(-1 * var(--wp--preset--spacing--edge-space, 80px));
	}

	& svg {
		display: block;
		width: 188px;
		height: 13px;
		margin: 0 auto;
		fill: var(--wp-global-header--text-color--light); /* The shared footer rule fills SVGs with the main text colour. */
	}

	/* The translated text is used on non-English locales. */
	& .global-footer__code_is_poetry {
		display: block;
		font-family: serif; /* MrsEaves doesn't support non-latin characters well. */
		font-size: 18px; /* Cap height roughly matches the 13px English graphic. */
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}
}

/* The light footer variant gets a dark divider instead. */
.wp-block-group.global-footer.has-white-background-color .global-footer__logos-container {
	border-top-color: rgba(0, 0, 0, 0.15);
}
