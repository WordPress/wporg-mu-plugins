.wp-block-group.global-footer .global-footer__logos-container {
	position: relative;
	display: flex;
	flex-wrap: wrap;
	gap: var(--wp--style--block-gap) calc(var(--wp--style--block-gap) * 3);
	margin-top: 60px;

	@media (--tablet) {
		justify-content: space-between;
		flex-wrap: nowrap;
		align-items: center; /* Icons wrap to two rows here, so centre them on the logo block. */
	}

	@media (--desktop) {
		align-items: flex-start; /* Icons fit on one row, so line them up with the logo. */
	}

	& .global-footer__wporg-logo-full {
		& a {
			color: var(--wp-global-header--text-color);
		}

		& svg {
			height: 27px;
			width: auto;
		}
	}

	& .global-footer__wporg-container {
		flex-grow: 1;

		& > :first-child {
			gap: var(--wp--style--block-gap);
		}
	}

	& .wp-block-image {
		text-align: left;
		margin: 0;
		position: unset;

		& a {
			display: block;
			line-height: 1;
		}
	}

	& .global-footer__wporg-locale-title {
		font-size: 16px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;

		@media (--tablet) {
			font-size: 13px;
			max-width: 8em;
		}

		@media (--desktop) {
			max-width: 15em;
		}

		@media (--desktop-wide) {
			max-width: 20em;
		}

		& a {
			color: inherit;
			text-decoration: none;

			&:hover,
			&:focus {
				text-decoration: underline;
			}
		}
	}
}

/* "Code is Poetry" sits at the top left of the footer, above the navigation. */
.wp-block-group.global-footer {

	/* An image is used on `en_*` locales. */
	& .wp-block-image.global-footer__code_is_poetry {
		margin: 0 0 35px;
		text-align: left;

		@media (--tablet) {
			margin-bottom: 50px;
		}

		& img {
			display: block;
			width: 188px;
			height: 13px;
		}
	}

	/* The translated text is used on non-English locales. */
	& span.global-footer__code_is_poetry {
		display: block;
		margin-bottom: 35px;
		font-family: serif; /* MrsEaves doesn't support non-latin characters well. */
		font-size: 20px;
		line-height: 1;
		color: rgba(255, 255, 255, 0.25);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		text-align: left;

		@media (--tablet) {
			margin-bottom: 50px;
		}
	}

	&.has-white-background-color span.global-footer__code_is_poetry {
		color: #8f8f8f;
	}

	/* Sits directly below the WordPress.org logo, matching the navigation link size. */
	& .global-footer__trademark {
		margin-top: 0;
		line-height: 1.5;
		color: var(--wp-global-header--text-color--light);

		@media (--tablet) {
			font-size: var(--wp--preset--font-size--small);
		}
	}
}
