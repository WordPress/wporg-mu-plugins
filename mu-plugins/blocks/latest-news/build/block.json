{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "wporg/latest-news",
	"version": "0.1.0-b46e7faa1ea7f9296687dfd83e3a494f201ad55d",
	"title": "Latest News",
	"category": "widgets",
	"icon": "editor-ul",
	"description": "Display the latest news from WordPress.org.",
	"textdomain": "wporg",
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"attributes": {
		"blogId": {
			"type": "integer",
			"default": 0
		},
		"perPage": {
			"type": "integer",
			"default": 3
		},
		"postTypes": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": [
				"post"
			]
		},
		"showCategories": {
			"type": "boolean",
			"default": false
		}
	}
}